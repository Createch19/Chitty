# Copy to .env.local for local development. In production these are Coolify secrets.
# Without DATABASE_URL the app uses an embedded PostgreSQL (PGlite) in ./.data/pglite.
DATABASE_URL=
# Super Admin created on the very first start (only if none exists yet).
SUPERADMIN_MOBILE=
SUPERADMIN_PASSWORD=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://chitty.creaitechnology.com

# Aadhaar encryption key (32 bytes, base64). Back it up separately: losing it loses every stored Aadhaar.
CHITTY_AADHAAR_KEY=
